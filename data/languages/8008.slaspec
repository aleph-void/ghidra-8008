# sleigh specification file for Intel 8008
#
# The 8008 has seven 8-bit registers (A B C D E H L), a 14-bit address space, a pseudo-register M
# (the byte addressed by H:L, only the low six bits of H count), four condition flip-flops
# (carry, zero, sign, parity), 8 input ports (IN 0-7), 24 output ports (OUT 8-31) and an on-chip
# push-down stack of eight 14-bit entries (seven nested CALLs; the eighth level is the program
# counter).  Source of the encodings and flag rules: Intel 8008 User's Manual (1972/1973); the
# mnemonics are the 8080-style ones of the manual's later editions.

define endian=little;
define alignment=1;

define space mem		type=ram_space			size=2 default;
define space io			type=ram_space			size=1;
define space register 	type=register_space		size=1;

define register offset=0x00 size=1 [ A C B E D L H ];
define register offset=0x20 size=2 [ PC ];
# Stack pointer of the on-chip return stack.  The hardware stack has no address (it is eight 14-bit
# registers inside the chip); it is modelled as a normal downward stack in the top of the 16-bit memory
# space, 0xFFF0-0xFFFF, which no 14-bit program address can reach (SP starts at 0).  Declaring it this way
# is what lets the decompiler hide the return-address traffic.  Overflow (more than seven nested CALLs,
# when the chip overwrites the oldest return address) is not modelled: the ring-buffer address arithmetic
# would defeat the decompiler's stack analysis and show a store at every call site.
define register offset=0x24 size=2 [ SP ];

# Flag bits
# CY: Carry
# P: Parity (set when the result has an even number of 1 bits)
# Z: Zero
# S: Sign
define register offset=0x30 size=1 [ S_flag Z_flag P_flag CY_flag ];

define token opbyte (8)
   op0_8     = (0,7)
   op6_2     = (6,7)
   op4_2     = (4,5)

   reg3_3 = (3,5)
   regN3_3 = (3,5)
   bits3_3   = (3,5)

   bits0_4   = (0,3)

   reg0_3 = (0,2)
   bits0_3   = (0,2)

   bit0   = (0,0)
   bits1_3 = (1,3)
;

define token data8 (8)
   imm8		= (0,7)
;

define token data16 (16)
   imm16        = (0,15)
;

# index 7 is the memory operand M and is handled by separate constructors
attach variables [ reg0_3 reg3_3 ] [ A B C D E H L _ ];
# INR/DCR: A and M do not exist
attach variables [ regN3_3 ] [ _ B C D E H L _ ];

################################################################
# Pseudo Instructions
################################################################

################################################################
# Macros
################################################################

# Z, S, P of an 8-bit result
macro setResultFlags(result) {
	Z_flag = (result == 0);
	S_flag = (result s< 0);
	local ones:1 = popcount(result);
	P_flag = ((ones & 1) == 0);
}

macro pushRet(val14) {
	SP = SP - 2;
	*:2 SP = val14;
}

macro popRet(val14) {
	val14 = *:2 SP;
	SP = SP + 2;
}

# A + x, A + x + carry, A - x, A - x - borrow (carry = borrow out) and the logical operations;
# x is read once, all flags are computed from the old operand values.
macro doAdd(x) {
	local a:1 = A;
	local s:1 = x;
	local r:1 = a + s;
	CY_flag = carry(a, s);
	A = r;
	setResultFlags(r);
}

macro doAdc(x) {
	local a:1 = A;
	local s:1 = x;
	local c:1 = CY_flag;
	local r:1 = a + s + c;
	CY_flag = carry(a, s) || carry(a + s, c);
	A = r;
	setResultFlags(r);
}

macro doSub(x) {
	local a:1 = A;
	local s:1 = x;
	local r:1 = a - s;
	CY_flag = a < s;
	A = r;
	setResultFlags(r);
}

macro doSbb(x) {
	local a:1 = A;
	local s:1 = x;
	local c:1 = CY_flag;
	local r:1 = a - s - c;
	local wa:2 = zext(a);
	local ws:2 = zext(s) + zext(c);
	CY_flag = wa < ws;
	A = r;
	setResultFlags(r);
}

macro doCmp(x) {
	local a:1 = A;
	local s:1 = x;
	local r:1 = a - s;
	CY_flag = a < s;
	setResultFlags(r);
}

macro doAnd(x) {
	local r:1 = A & x;
	CY_flag = 0;
	A = r;
	setResultFlags(r);
}

macro doXor(x) {
	local r:1 = A ^ x;
	CY_flag = 0;
	A = r;
	setResultFlags(r);
}

macro doOr(x) {
	local r:1 = A | x;
	CY_flag = 0;
	A = r;
	setResultFlags(r);
}

################################################################
# Operands
################################################################

# The program counter is 14 bits wide: the two high bits of the address bytes are ignored.
Addr14: loc		is imm16 [ loc = imm16 & 0x3fff; ]		{ export *:1 loc; }

RstAddr: loc		is bits3_3 [ loc = bits3_3 << 3; ]			{ export *:1 loc; }

InPort: bits1_3		is bits1_3						{ export *[io]:1 bits1_3; }

# OUT 8-31: bits 4-5 (non-zero) are the high bits of the port number
OutPort: port		is op4_2 & bits1_3 [ port = (op4_2 << 3) | bits1_3; ]	{ export *[io]:1 port; }

# the memory operand M: byte at H:L (14 bits)
MemM: "M"		is epsilon		{ local p:2 = ((zext(H) & 0x3f) << 8) | zext(L); export *[mem]:1 p; }

# ALU source operand (register or M)
Src: reg0_3		is reg0_3						{ export reg0_3; }
Src: MemM		is bits0_3=7 & MemM				{ export MemM; }

# Condition of JFc/JTc, CFc/CTc, RFc/RTc.  The "true" mnemonics test the flag, the "false" ones its
# complement; the display uses the 8080 style names.
cc: "NC"            is bits3_3=0x0                              { c:1 = (CY_flag == 0); export c; }
cc: "NZ"            is bits3_3=0x1                              { c:1 = (Z_flag == 0); export c; }
cc: "P"             is bits3_3=0x2                              { c:1 = (S_flag == 0); export c; }
cc: "PO"            is bits3_3=0x3                              { c:1 = (P_flag == 0); export c; }
cc: "C"             is bits3_3=0x4                              { export CY_flag; }
cc: "Z"             is bits3_3=0x5                              { export Z_flag; }
cc: "M"             is bits3_3=0x6                              { export S_flag; }
cc: "PE"            is bits3_3=0x7                              { export P_flag; }

################################################################
# Instructions
################################################################

# 0x00, 0x01 and 0xff (LMM) all halt the processor
:HLT  is op0_8=0x0 | op0_8=0x1 | op0_8=0xff  {
	goto inst_start;
}

:MOV reg3_3,reg0_3  is op6_2=0x3 & reg3_3 & reg0_3 {
	reg3_3 = reg0_3;
}

:MOV reg3_3,MemM  is op6_2=0x3 & reg3_3 & bits0_3=0x7 & MemM {
	reg3_3 = MemM;
}

:MOV MemM,reg0_3  is op6_2=0x3 & bits3_3=0x7 & reg0_3 & MemM {
	MemM = reg0_3;
}

:MVI reg3_3,imm8  is op6_2=0x0 & reg3_3 & bits0_3=0x6; imm8 {
	reg3_3 = imm8;
}

:MVI MemM,imm8  is op0_8=0x3e & MemM; imm8 {
	MemM = imm8;
}

# INR/DCR exist for B, C, D, E, H and L only (the codes for A and M are HLT / undefined)
:INR regN3_3  is op6_2=0x0 & regN3_3 & bits0_3=0x0 { regN3_3 = regN3_3 + 1; setResultFlags(regN3_3); }
:DCR regN3_3  is op6_2=0x0 & regN3_3 & bits0_3=0x1 { regN3_3 = regN3_3 - 1; setResultFlags(regN3_3); }


:ADD Src  is op6_2=0x2 & bits3_3=0x0 & Src { doAdd(Src); }
:ADC Src  is op6_2=0x2 & bits3_3=0x1 & Src { doAdc(Src); }
:SUB Src  is op6_2=0x2 & bits3_3=0x2 & Src { doSub(Src); }
:SBB Src  is op6_2=0x2 & bits3_3=0x3 & Src { doSbb(Src); }
:ANA Src  is op6_2=0x2 & bits3_3=0x4 & Src { doAnd(Src); }
:XRA Src  is op6_2=0x2 & bits3_3=0x5 & Src { doXor(Src); }
:ORA Src  is op6_2=0x2 & bits3_3=0x6 & Src { doOr(Src); }
:CMP Src  is op6_2=0x2 & bits3_3=0x7 & Src { doCmp(Src); }

:ADI imm8  is op0_8=0x04; imm8 { doAdd(imm8); }
:ACI imm8  is op0_8=0x0c; imm8 { doAdc(imm8); }
:SUI imm8  is op0_8=0x14; imm8 { doSub(imm8); }
:SBI imm8  is op0_8=0x1c; imm8 { doSbb(imm8); }
:ANI imm8  is op0_8=0x24; imm8 { doAnd(imm8); }
:XRI imm8  is op0_8=0x2c; imm8 { doXor(imm8); }
:ORI imm8  is op0_8=0x34; imm8 { doOr(imm8); }
:CPI imm8  is op0_8=0x3c; imm8 { doCmp(imm8); }

:RLC  is op0_8=0x02 {
	CY_flag = (A >> 7);
	A = (A << 1) | CY_flag;
}

:RRC  is op0_8=0x0a {
	CY_flag = (A & 1);
	A = (A >> 1) | (CY_flag << 7);
}

:RAL  is op0_8=0x12 {
	local nextC:1 = (A >> 7);
	A = (A << 1) | CY_flag;
	CY_flag = nextC;
}

:RAR  is op0_8=0x1a {
	local nextC:1 = (A & 1);
	A = (A >> 1) | (CY_flag << 7);
	CY_flag = nextC;
}

:JMP Addr14  is op6_2=0x1 & bits0_3=0x4; Addr14 {
	goto Addr14;
}

:J^cc Addr14  is op6_2=0x1 & cc & bits0_3=0x0; Addr14 {
	if (cc) goto Addr14;
}

:CALL Addr14  is op6_2=0x1 & bits0_3=0x6; Addr14 {
	local tmp:2 = inst_next;
	pushRet(tmp);
	call Addr14;
}

:C^cc Addr14  is op6_2=0x1 & cc & bits0_3=0x2; Addr14 {
	if (!cc) goto inst_next;
	local tmp:2 = inst_next;
	pushRet(tmp);
	call Addr14;
}

:RET  is op6_2=0x0 & bits0_3=0x7 {
	local tmp:2 = 0;
	popRet(tmp);
	return [tmp];
}

:R^cc  is op6_2=0x0 & cc & bits0_3=0x3 {
	if (!cc) goto inst_next;
	local tmp:2 = 0;
	popRet(tmp);
	return [tmp];
}

:RST RstAddr  is op6_2=0x0 & RstAddr & bits0_3=0x5 {
	local tmp:2 = inst_next;
	pushRet(tmp);
	call RstAddr;
}

:IN InPort  is op6_2=0x1 & op4_2=0x0 & InPort & bit0=0x1 {
	A = InPort;
}

:OUT OutPort  is op6_2=0x1 & op4_2 != 0 & OutPort & bit0=0x1 {
	OutPort = A;
}
